# ============ 廊坊一中回忆录 · 环境变量 ============
# 复制一份改名为 .env 使用（也可以不建 .env，全部用默认值）

# 服务端口
PORT=3000

# 站点对外地址（用于生成分享链接、日志展示）
SITE_URL=http://localhost:3000

# ---- 安全相关 ----
# 会话签名密钥（不填会在 data/.session-secret 自动生成）
SESSION_SECRET=

# 后台管理密码（不填会在 data/.admin-password 自动生成并打印到控制台）
ADMIN_PASSWORD=

# 部署在 Nginx / 云负载均衡后面时设为 1，才能拿到真实用户 IP
TRUST_PROXY=0

# ---- 目录 ----
# 数据与上传目录，默认 ./data 和 ./uploads（Docker 里会挂载到 /app/data）
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# ---- 内容策略 ----
# 新用户第一条回忆是否需要管理员审核后才公开（1 = 需要）
REVIEW_FIRST_POST=0

# 单条回忆最大字数
MAX_POST_CHARS=8000

# ---- 导入 / 上传文档 ----
# 单个上传文件（文档）的大小上限（MB）。默认 500 = 500MB。
# 上传是磁盘流，不占内存；但请确认服务器磁盘够放（uploads/docs/）。
# 用 Nginx 反代时，client_max_body_size 必须 >= 这个值，否则大文件在 Nginx 层就被挡了。
MAX_UPLOAD_MB=500

# 站长在后台「导入回忆」时单个文件的上限（MB）。默认 2560 = 2.5GB。
# 整年级的回忆合集动辄一两个 G，所以后台这个口子单独放宽；校友侧仍受 MAX_UPLOAD_MB 限制。
# 同样要保证 Nginx 的 client_max_body_size >= 这个值（部署文件里给到 2600m）。
MAX_IMPORT_UPLOAD_MB=2560

# 每个校友每天最多传几份文档（防止把网站当网盘），默认 10
DOC_DAILY_LIMIT=10

# 单张配图的大小上限（MB），默认 8
MAX_IMAGE_MB=8

# ---- 整篇文档模式（后台「导入 → 整篇文档」：一份 Word = 一条回忆，照片原样保留）----
# 一篇里的照片总量上限（MB）。照片按原尺寸落在 uploads/posts/<回忆id>/，默认 4096 = 4GB
MAX_DOC_IMAGES_MB=4096

# Word 内部 word/document.xml 的上限（MB）。正常文档只有几 MB，这里只是防止畸形文件撑爆内存
MAX_DOC_XML_MB=192

# 整篇转出来的正文 HTML 上限（字符数），超了尾部截断并在页面上提示，默认 600 万
MAX_DOC_HTML_CHARS=6000000


# ---- 日志保留 ----
# 访问日志最多留多少条（环形缓冲，超了丢最旧的）。人多的时候可以调大，代价是 db.json 变大
MAX_VISITS=100000

# 关键事件（登录/发布/删除/封禁）最多留多少条
MAX_EVENTS=5000

# ---- 校友密码 ----
# 密码策略（最短位数、输错几次锁定、锁多久、是否强制改密、是否允许自助改密）
# 不在 .env 里配，而是登录后台 → 密码管控 → 密码策略，改完立即生效（存在 data/db.json）