# 统一换行：Windows 上编辑、Linux 上部署都不出错
* text=auto

# Linux 上要直接执行的脚本，必须是 LF（CRLF 会让 bash 报 $'\r': command not found）
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Windows 专用脚本保持 CRLF（PowerShell 5.1 读 UTF-8 需要 BOM，见 scripts/smoke.ps1）
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.docx binary
*.zip binary
*.gz binary